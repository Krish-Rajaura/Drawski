<Window x:Class="Drawski.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Drawski"
        Title="Drawski" Width="640" Height="760" MinWidth="580" MinHeight="520" WindowStartupLocation="CenterScreen"
        Background="#17181B" Foreground="#E8E8E8" FontFamily="Segoe UI" Icon="/assets/Drawski.ico">
    <Window.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#9A9CA3"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="Group" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#B9BBC2"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
        </Style>

        <!-- One of the 6 toolbar slots, blue ring = the slot being edited -->
        <Style x:Key="SlotSwatch" TargetType="RadioButton">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="GroupName" Value="Slots"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Border x:Name="ring" CornerRadius="14" BorderThickness="3" BorderBrush="#5A5C63" Visibility="Hidden"/>
                            <Border Margin="6" CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="#3A3B41" BorderThickness="1"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ring" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ring" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ring" Property="BorderBrush" Value="#4F8CFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Tabs" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="#2C2D32" BorderThickness="0,0,0,1" Padding="16,0">
                                <TabPanel IsItemsHost="True"/>
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#9A9CA3"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tab" Padding="14,10" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#E8E8E8"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tab" Property="BorderBrush" Value="#4F8CFF"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="24,16,24,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Viewbox Width="44" Height="44" VerticalAlignment="Center">
                <Canvas Width="256" Height="256">
                    <Rectangle Canvas.Left="8" Canvas.Top="8" Width="240" Height="240" RadiusX="56" RadiusY="56">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#2B2C30" Offset="0"/>
                                <GradientStop Color="#18191C" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Path Data="M86 56 C82 104 82 152 86 200 C198 214 220 52 78 62" Stroke="#FF3B30" StrokeThickness="24"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Canvas>
            </Viewbox>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Drawski" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="Running. The toolbar is on the left of your screen." FontSize="13" Foreground="#9A9CA3" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <TabControl x:Name="_tabs" Grid.Row="1" Style="{StaticResource Tabs}">
            <TabItem Header="Colours">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,20,24,20">
                        <TextBlock Text="Toolbar colours" Style="{StaticResource Heading}"/>
                        <TextBlock Text="Pick a slot, choose its colour on the wheel or from My colours, then Apply." Style="{StaticResource Note}"/>
                        <StackPanel x:Name="_slotsPanel" Orientation="Horizontal"/>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <local:ColorWheel x:Name="_wheel" VerticalAlignment="Top"/>

                            <StackPanel Grid.Column="1" Margin="24,0,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Border x:Name="_slotPreview" Height="48" CornerRadius="8,0,0,8"/>
                                        <TextBlock x:Name="_slotPreviewLabel" FontSize="12" Foreground="#9A9CA3" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <Border x:Name="_newPreview" Height="48" CornerRadius="0,8,8,0"/>
                                        <TextBlock Text="New" FontSize="12" Foreground="#9A9CA3" Margin="0,4,0,0" HorizontalAlignment="Right"/>
                                    </StackPanel>
                                </Grid>

                                <Button x:Name="_applyButton" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0" Click="OnApplyClick"/>
                                <Button x:Name="_addSavedButton" Content="Add to My colours" Style="{StaticResource DialogButton}" Margin="0,8,0,0" Click="OnAddSavedClick"/>

                                <TextBlock Text="My colours" Style="{StaticResource Group}" Margin="0,22,0,2"/>
                                <TextBlock Text="Click to load into the wheel. Right-click to remove." FontSize="12" Foreground="#9A9CA3" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <WrapPanel x:Name="_savedPanel"/>
                                <TextBlock x:Name="_savedEmpty" Text="Nothing saved yet. Pick a colour and click Add to My colours." FontSize="12"
                                           Foreground="#6E7077" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <Button Content="Reset toolbar colours" Style="{StaticResource DialogButton}" HorizontalAlignment="Left" Margin="0,22,0,0" Click="OnResetColoursClick"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Shortcuts">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24,20,24,20">
                        <TextBlock Text="Shortcuts" Style="{StaticResource Heading}"/>
                        <TextBlock Text="Click a shortcut, then press the keys you want. Click it again to cancel." Style="{StaticResource Note}"/>

                        <TextBlock Text="Work in any app (need Ctrl or Alt)" Style="{StaticResource Group}"/>
                        <StackPanel x:Name="_globalRows"/>

                        <TextBlock Text="While drawing" Style="{StaticResource Group}" Margin="0,16,0,6"/>
                        <StackPanel x:Name="_localRows"/>

                        <TextBlock x:Name="_shortcutMessage" FontSize="13" Foreground="#FFB454" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        <Button Content="Reset all shortcuts" Style="{StaticResource DialogButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnResetShortcutsClick"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="General">
                <StackPanel Margin="24,20,24,20">
                    <TextBlock Text="Startup" Style="{StaticResource Heading}" Margin="0,0,0,10"/>
                    <CheckBox x:Name="_startupCheck" Content="Show this window when Drawski starts" Foreground="#E8E8E8" FontSize="14"
                              Click="OnStartupCheckClick"/>
                    <TextBlock Text="You can always open it from the gear button on the toolbar." Style="{StaticResource Note}" Margin="22,4,0,0"/>

                    <TextBlock Text="About" Style="{StaticResource Heading}" Margin="0,16,0,6"/>
                    <TextBlock x:Name="_versionText" FontSize="13"/>
                    <TextBlock x:Name="_settingsPathText" FontSize="13" Foreground="#9A9CA3" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock FontSize="13" Margin="0,4,0,0">
                        <Hyperlink NavigateUri="https://github.com/Krish-Rajaura/Drawski" RequestNavigate="OnLinkClick" Foreground="#6A9DFF">github.com/Krish-Rajaura/Drawski</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#1B1C1F" BorderBrush="#2C2D32" BorderThickness="0,1,0,0" Padding="24,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Style="{StaticResource DialogButton}" Margin="0,0,8,0" Click="OnCloseClick"/>
                <Button Content="Start drawing" Style="{StaticResource PrimaryButton}" Click="OnStartDrawingClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
