<Window x:Class="Drawski.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Drawski" Width="600" Height="760" MinWidth="460" MinHeight="420" WindowStartupLocation="CenterScreen"
        Background="#17181B" Foreground="#E8E8E8" FontFamily="Segoe UI" Icon="/assets/Drawski.ico">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#202125"/>
            <Setter Property="BorderBrush" Value="#2C2D32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>

        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#9A9CA3"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="Group" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#B9BBC2"/>
            <Setter Property="Margin" Value="0,6,0,6"/>
        </Style>

        <Style x:Key="SwatchButton" TargetType="Button">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="box" Background="{TemplateBinding Background}" CornerRadius="12" BorderBrush="#3A3B41" BorderThickness="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="White"/>
                                <Setter TargetName="box" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="620">
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Viewbox Width="52" Height="52" VerticalAlignment="Top">
                    <Canvas Width="256" Height="256">
                        <Rectangle Canvas.Left="8" Canvas.Top="8" Width="240" Height="240" RadiusX="56" RadiusY="56">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#2B2C30" Offset="0"/>
                                    <GradientStop Color="#18191C" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Path Data="M86 56 C82 104 82 152 86 200 C198 214 220 52 78 62" Stroke="#FF3B30" StrokeThickness="24"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Canvas>
                </Viewbox>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Drawski" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Text="Running. The toolbar is on the left of your screen. Draw with it or with the shortcuts below."
                               FontSize="13" Foreground="#9A9CA3" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Toolbar colours" Style="{StaticResource Heading}"/>
                    <TextBlock Text="The six colours on the toolbar. Click one to change it." Style="{StaticResource Note}"/>
                    <UniformGrid x:Name="_paletteGrid" Columns="6" HorizontalAlignment="Left"/>
                    <Button Content="Reset colours" Style="{StaticResource DialogButton}" HorizontalAlignment="Left" Margin="0,14,0,0" Click="OnResetColoursClick"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Shortcuts" Style="{StaticResource Heading}"/>
                    <TextBlock Text="Click a shortcut, then press the keys you want. Click it again to cancel." Style="{StaticResource Note}"/>

                    <TextBlock Text="Work in any app (need Ctrl or Alt)" Style="{StaticResource Group}"/>
                    <StackPanel x:Name="_globalRows"/>

                    <TextBlock Text="While drawing" Style="{StaticResource Group}" Margin="0,16,0,6"/>
                    <StackPanel x:Name="_localRows"/>

                    <TextBlock x:Name="_shortcutMessage" FontSize="13" Foreground="#FFB454" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    <Button Content="Reset all shortcuts" Style="{StaticResource DialogButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OnResetShortcutsClick"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox x:Name="_startupCheck" Content="Show this window when Drawski starts" Foreground="#E8E8E8" FontSize="14"
                              Click="OnStartupCheckClick"/>
                    <TextBlock Text="You can always open it from the gear button on the toolbar." Style="{StaticResource Note}" Margin="22,4,0,0"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Style="{StaticResource DialogButton}" Margin="0,0,8,0" Click="OnCloseClick"/>
                <Button Content="Start drawing" Style="{StaticResource PrimaryButton}" Click="OnStartDrawingClick"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
