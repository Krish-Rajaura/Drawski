<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>Drawski</RootNamespace>
    <AssemblyName>Drawski</AssemblyName>
    <Version>1.1.1</Version>
    <Product>Drawski</Product>
    <ApplicationIcon>assets\Drawski.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="assets\Drawski.ico" />
  </ItemGroup>

  <!-- Faster startup and a lighter runtime -->
  <PropertyGroup>
    <PublishReadyToRun>true</PublishReadyToRun>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <!-- Pinned: 6.2.4 is the last MIT version, 6.5+ is AGPL with a license check. Don't upgrade -->
    <PackageReference Include="PDFsharp" Version="[6.2.4]" />
  </ItemGroup>

</Project>
