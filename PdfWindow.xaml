<Window x:Class="Drawski.PdfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Drawski" Width="1100" Height="800" WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="#2B2C30">
    <Grid>
        <ScrollViewer x:Name="_scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      ScrollChanged="OnScrollChanged" PreviewMouseWheel="OnPreviewMouseWheel">
            <StackPanel x:Name="_pagesPanel" HorizontalAlignment="Center">
                <StackPanel.LayoutTransform>
                    <ScaleTransform x:Name="_zoomTransform"/>
                </StackPanel.LayoutTransform>
            </StackPanel>
        </ScrollViewer>

        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,16" Padding="10,4"
                CornerRadius="8" Background="#CC1E1F22" IsHitTestVisible="False">
            <TextBlock x:Name="_status" Foreground="#E6E6E6" FontFamily="Segoe UI" FontSize="12"/>
        </Border>
    </Grid>
</Window>
