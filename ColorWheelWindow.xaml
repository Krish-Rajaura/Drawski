<Window x:Class="Drawski.ColorWheelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick a colour" SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Topmost="True" Background="#1E1F22" Foreground="#E8E8E8" FontFamily="Segoe UI" Icon="/assets/Drawski.ico">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="150"/>
        </Grid.ColumnDefinitions>

        <StackPanel>
            <Grid x:Name="_wheelHost" Width="240" Height="240" Background="Transparent" Cursor="Cross"
                  MouseLeftButtonDown="OnWheelDown" MouseMove="OnWheelMove" MouseLeftButtonUp="OnPointerUp">
                <Image x:Name="_wheel"/>
                <Canvas IsHitTestVisible="False">
                    <Grid x:Name="_wheelMarker" Width="18" Height="18">
                        <Ellipse Stroke="#99000000" StrokeThickness="1"/>
                        <Ellipse Margin="1" Stroke="White" StrokeThickness="2.5"/>
                    </Grid>
                </Canvas>
            </Grid>

            <Grid x:Name="_valueHost" Width="240" Height="22" Margin="0,18,0,0" Background="Transparent" Cursor="Hand"
                  MouseLeftButtonDown="OnValueDown" MouseMove="OnValueMove" MouseLeftButtonUp="OnPointerUp">
                <Border x:Name="_valueBar" CornerRadius="11" BorderBrush="#3A3B41" BorderThickness="1"/>
                <Canvas IsHitTestVisible="False">
                    <Grid x:Name="_valueMarker" Width="18" Height="18" Canvas.Top="2">
                        <Ellipse Stroke="#99000000" StrokeThickness="1"/>
                        <Ellipse Margin="1" Stroke="White" StrokeThickness="2.5"/>
                    </Grid>
                </Canvas>
            </Grid>
            <TextBlock Text="Brightness" FontSize="12" Foreground="#9A9CA3" Margin="2,6,0,0"/>
        </StackPanel>

        <DockPanel Grid.Column="1" Margin="24,0,0,0">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="New" FontSize="12" Foreground="#9A9CA3" Margin="0,0,0,4"/>
                <Border x:Name="_newPreview" Height="56" CornerRadius="8,8,0,0"/>
                <Border x:Name="_oldPreview" Height="36" CornerRadius="0,0,8,8" Cursor="Hand"
                        MouseLeftButtonDown="OnOldPreviewClick" ToolTip="Click to go back to the current colour"/>
                <TextBlock Text="Current" FontSize="12" Foreground="#9A9CA3" Margin="0,4,0,0"/>

                <TextBlock Text="Hex" FontSize="12" Foreground="#9A9CA3" Margin="0,18,0,4"/>
                <TextBox x:Name="_hexBox" FontSize="15" Padding="6,5" Background="#2C2D32" Foreground="#E8E8E8"
                         BorderBrush="#3A3B41" CaretBrush="White" MaxLength="7" TextChanged="OnHexChanged"/>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="Cancel" Style="{StaticResource DialogButton}" IsCancel="True" Margin="0,0,8,0"/>
                <Button Content="OK" Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="64" Click="OnOkClick"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
